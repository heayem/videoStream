PORT=3000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_change_in_production_12345
JWT_EXPIRE=7d
BCRYPT_ROUNDS=10
DATABASE_URL=mongodb://localhost:27017/videostream
UPLOADS_DIR=./uploads
OUTPUT_DIR=./output
PUBLIC_DIR=./public
MAX_FILE_SIZE=500000000
ALLOWED_MIME_TYPES=video/mp4,video/mpeg,video/quicktime,video/x-msvideo
FFMPEG_PATH=/usr/bin/ffmpeg
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
